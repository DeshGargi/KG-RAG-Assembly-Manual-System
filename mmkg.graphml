<node id="warning_clip_damage">
  <data key="d0">Clip damage warning</data>
  <data key="d1">Warning</data>
  <data key="d12">warn_01</data>
  <data key="d13">NOTE</data>
  <data key="d7">Failure to slide the clips over the hose at this time will require the clips to be stretched over the hose or fitting later. This may permanently damage the clip.</data>
  <data key="d5">text</data>
