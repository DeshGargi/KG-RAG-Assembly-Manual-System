<graph edgedefault="directed"><node id="doc_ez_clip_5400">
  <data key="d0">Danfoss EZ Clip to 5400 Series Hose assembly instructions</data>
  <data key="d1">Document</data>
  <data key="d2">AN463656012492en-000101</data>
  <data key="d3">Danfoss EZ Clip to 5400 Series Hose assembly instructions</data>
  <data key="d4">1-2</data>
  <data key="d5">text</data>
</node>
<node id="step_1">
  <data key="d0">Cut the hose</data>
  <data key="d1">AssemblyStep</data>
  <data key="d6">1</data>
  <data key="d7">Cut the hose to proper length with an appropriate cutting tool.</data>
  <data key="d5">text</data>
</node>
<node id="step_2">
  <data key="d0">Slip on two clips</data>
  <data key="d1">AssemblyStep</data>
  <data key="d6">2</data>
  <data key="d7">Install two proper-sized clips onto the cut end of the hose.</data>
  <data key="d5">text</data>
</node>
<node id="step_3">
  <data key="d0">Oil the nipple</data>
  <data key="d1">AssemblyStep</data>
  <data key="d6">3</data>
  <data key="d7">Lubricate the nipple with a generous amount of the refrigeration or A/C system’s compressor lubricating oil.</data>
  <data key="d5">text</data>
</node>
<node id="step_4">
  <data key="d0">Insert the nipple</data>
  <data key="d1">AssemblyStep</data>
  <data key="d6">4</data>
  <data key="d7">Insert the nipple into the hose.</data>
  <data key="d5">text</data>
</node>
<node id="step_5">
  <data key="d0">Snap on the cage</data>
  <data key="d1">AssemblyStep</data>
  <data key="d6">5</data>
  <data key="d7">Snap the cage into the groove on the nipple.</data>
  <data key="d5">text</data>
</node>
<node id="step_6">
  <data key="d0">Slide the clips</data>
  <data key="d1">AssemblyStep</data>
  <data key="d6">6</data>
  <data key="d7">Slide the clips over the cage arms and into the channels on each arm.</data>
  <data key="d5">text</data>
</node>
<node id="step_7">
  <data key="d0">Close the clips</data>
  <data key="d1">AssemblyStep</data>
  <data key="d6">7</data>
  <data key="d7">Use the FT1357 pliers to close the clips.</data>
  <data key="d5">text</data>
</node>
<node id="tool_ft1357">
  <data key="d0">FT1357 Pliers</data>
  <data key="d1">Tool</data>
  <data key="d8">ft1357</data>
  <data key="d9">pliers</data>
  <data key="d5">text</data>
</node>
